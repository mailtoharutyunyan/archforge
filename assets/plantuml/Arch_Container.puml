!endprocedure

!unquoted procedure ContainerDb($alias, $label, $techn="", $descr="", $sprite="arch_database")
database "$archLabel($label, $techn, $descr, $sprite)" <<arch_db>> as $alias
!endprocedure

!unquoted procedure ContainerDb_Ext($alias, $label, $techn="", $descr="", $sprite="arch_database")
database "$archLabel($label, $techn, $descr, $sprite)" <<arch_db>> as $alias
!endprocedure

