' Archforge for PlantUML — container level
'
'   !include https://<you>.github.io/archforge/plantuml/Arch_Container.puml
'
'   Person(customer, "Customer")
'   System_Boundary(payments, "Payment Platform") {
'     Container(api, "Payment API", "Java 21 / Spring Boot", "Authorises payments")
'     ContainerDb(db, "Payments DB", "PostgreSQL 16", "Stores payments")
'     ContainerQueue(events, "payment.events", "Apache Kafka")
'   }
'   Rel(customer, api, "Pays", "HTTPS/JSON")
'
' Licence: Apache-2.0.

!if %variable_exists("$ARCH_CONTAINER_INCLUDED")
!return
!endif
!$ARCH_CONTAINER_INCLUDED = 1

' Where the rest of the library is loaded from.
'
' Remote use needs absolute URLs: PlantUML does not resolve a relative
' `!include` against a parent that was itself fetched over http, so a chain of
' relative includes fails as soon as the entry point is a URL. Local use needs
' the opposite. So both are provided, switched by a flag, exactly as
' C4-PlantUML does:
'
'   remote (default)  !include <base>/Arch_Container.puml
'   local             plantuml -DRELATIVE_INCLUDE="." your-diagram.puml
'
' Override the base to point at your own fork or a vendored copy:
'   plantuml -DARCH_INCLUDE_BASE="https://example.com/plantuml" ...
!$ARCH_INCLUDE_BASE ?= "https://raw.githubusercontent.com/mailtoharutyunyan/archforge/main/assets/plantuml"
!if %variable_exists("RELATIVE_INCLUDE")
  !include ./Arch_Context.puml
!else
  !include $ARCH_INCLUDE_BASE/Arch_Context.puml
!endif

!unquoted procedure Container($alias, $label, $techn="", $descr="", $sprite="arch_container")
rectangle "$archLabel($label, $techn, $descr, $sprite)" <<arch_container>> as $alias
!endprocedure

!unquoted procedure Container_Ext($alias, $label, $techn="", $descr="", $sprite="arch_external")
rectangle "$archLabel($label, $techn, $descr, $sprite)" <<arch_external>> as $alias
!endprocedure

!unquoted procedure ContainerApi($alias, $label, $techn="", $descr="", $sprite="arch_api")
rectangle "$archLabel($label, $techn, $descr, $sprite)" <<arch_api>> as $alias
!endprocedure

!unquoted procedure ContainerDb($alias, $label, $techn="", $descr="", $sprite="arch_database")
database "$archLabel($label, $techn, $descr, $sprite)" <<arch_db>> as $alias
!endprocedure

!unquoted procedure ContainerDb_Ext($alias, $label, $techn="", $descr="", $sprite="arch_database")
database "$archLabel($label, $techn, $descr, $sprite)" <<arch_db>> as $alias
