' Archforge for PlantUML — system context level
'
'   !include https://<you>.github.io/archforge/plantuml/Arch_Context.puml
'
'   Person(customer, "Customer", "Buys things")
'   System(payments, "Payment Platform", "Takes payments")
'   System_Ext(cards, "Card Network", "Authorises cards")
'   Rel(customer, payments, "Pays", "HTTPS")
'
' Licence: Apache-2.0.

!if %variable_exists("ARCH_CONTEXT_INCLUDED")
!return
!endif
!$ARCH_CONTEXT_INCLUDED = 1

' Where the rest of the library is loaded from.
'
' Remote use needs absolute URLs: PlantUML does not resolve a relative
' `!include` against a parent that was itself fetched over http, so a chain of
' relative includes fails as soon as the entry point is a URL. Local use needs
' the opposite. So both are provided, switched by a flag, exactly as
' C4-PlantUML does:
'
'   remote (default)  !include <base>/Arch_Container.puml
'   local             plantuml -DRELATIVE_INCLUDE="." your-diagram.puml
'
' Override the base to point at your own fork or a vendored copy:
'   plantuml -DARCH_INCLUDE_BASE="https://example.com/plantuml" ...
!$ARCH_INCLUDE_BASE ?= "https://raw.githubusercontent.com/mailtoharutyunyan/archforge/main/assets/plantuml"
!if %variable_exists("RELATIVE_INCLUDE")
  !include ./Arch_Common.puml
!else
  !include $ARCH_INCLUDE_BASE/Arch_Common.puml
!endif

' ------------------------------------------------------------------ people

!unquoted procedure Person($alias, $label, $descr="", $sprite="arch_person")
actor "$archLabel($label, "", $descr, $sprite)" <<arch_person>> as $alias
!endprocedure

!unquoted procedure Person_Ext($alias, $label, $descr="", $sprite="arch_person")
actor "$archLabel($label, "external", $descr, $sprite)" <<arch_person>> as $alias
!endprocedure

' ----------------------------------------------------------------- systems

!unquoted procedure System($alias, $label, $descr="", $sprite="arch_system")
rectangle "$archLabel($label, "", $descr, $sprite)" <<arch_system>> as $alias
!endprocedure

!unquoted procedure System_Ext($alias, $label, $descr="", $sprite="arch_external")
rectangle "$archLabel($label, "external", $descr, $sprite)" <<arch_external>> as $alias
!endprocedure

!unquoted procedure SystemDb($alias, $label, $descr="", $sprite="arch_database")
database "$archLabel($label, "", $descr, $sprite)" <<arch_db>> as $alias
!endprocedure

!unquoted procedure SystemDb_Ext($alias, $label, $descr="", $sprite="arch_database")
database "$archLabel($label, "external", $descr, $sprite)" <<arch_db>> as $alias
!endprocedure

!unquoted procedure SystemQueue($alias, $label, $descr="", $sprite="arch_queue")
queue "$archLabel($label, "", $descr, $sprite)" <<arch_queue>> as $alias
!endprocedure

!unquoted procedure SystemQueue_Ext($alias, $label, $descr="", $sprite="arch_queue")
queue "$archLabel($label, "external", $descr, $sprite)" <<arch_queue>> as $alias
!endprocedure
