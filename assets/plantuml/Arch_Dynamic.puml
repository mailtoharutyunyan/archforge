' Archforge for PlantUML — dynamic / interaction level
'
'   !include https://<you>.github.io/archforge/plantuml/Arch_Dynamic.puml
'
'   Person(customer, "Customer")
'   Container(api, "Payment API", "Java")
'   ContainerDb(db, "Payments DB", "PostgreSQL")
'
'   RelIndex(customer, api, "Submits card", "HTTPS")
'   RelIndex(api, db, "Persists the intent", "JDBC")
'
' RelIndex() numbers each interaction in the order you write it, which is what
' makes a dynamic view readable. Call ResetIndex() to start again at 1.
'
' Licence: Apache-2.0.

!if %variable_exists("$ARCH_DYNAMIC_INCLUDED")
!return
!endif
!$ARCH_DYNAMIC_INCLUDED = 1

!include Arch_Container.puml

!$ARCH_INDEX = 0

!unquoted procedure ResetIndex()
!$ARCH_INDEX = 0
!endprocedure

!unquoted procedure SetIndex($value)
!$ARCH_INDEX = $value - 1
!endprocedure

!unquoted procedure RelIndex($from, $to, $label="", $techn="")
!$ARCH_INDEX = $ARCH_INDEX + 1
$from --> $to : <b>$ARCH_INDEX.</b> $archRelLabel($label, $techn)
!endprocedure

!unquoted procedure RelIndex_Back($from, $to, $label="", $techn="")
!$ARCH_INDEX = $ARCH_INDEX + 1
$from <-- $to : <b>$ARCH_INDEX.</b> $archRelLabel($label, $techn)
!endprocedure
