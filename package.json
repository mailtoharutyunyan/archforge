{
  "name": "archforge",
  "version": "0.1.0",
  "private": true,
  "description": "Architecture as code: one model, derived C4 views, deterministic renders, architecture lint, drift detection against real repositories.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.6"
  },
  "bin": {
    "arch": "./packages/cli/bin/arch.mjs"
  },
  "scripts": {
    "test": "node --test --test-reporter=spec \"test/**/*.test.ts\"",
    "arch": "node ./packages/cli/src/main.ts",
    "check:example": "node ./packages/cli/src/main.ts check examples/payment-platform/architecture.arch",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "architecture",
    "c4",
    "architecture-as-code",
    "diagrams",
    "architecture-lint",
    "drift"
  ]
}
